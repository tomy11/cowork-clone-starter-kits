# ====== LLM Provider ======
# ตัวเลือก: "claude" หรือ "openai-compat"
LLM_PROVIDER=claude

# ====== Claude (default) ======
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5

# ====== OpenAI-compatible (alternative) ======
# ใช้ได้กับ: OpenAI, Gemini (compat endpoint), Ollama, GLM, DeepSeek, etc.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# ====== Skills ======
SKILLS_DIR=./skills
